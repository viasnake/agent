{
  "name": "@viasnake/agent",
  "version": "0.1.0",
  "private": true,
  "description": "A local, policy-controlled multi-model agent for coding, research, and writing",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "bin": {
    "agent": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "examples"
  ],
  "scripts": {
    "prebuild": "npm install --ignore-scripts --no-audit --no-fund",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "tsc --outDir .test-dist && node --test --experimental-test-isolation=none --test-concurrency=1 .test-dist/tests/*.test.js",
    "test:firecracker": "python3 -B -m unittest discover -s tests/firecracker -p 'test_*.py'",
    "verify": "npm run format:check && npm run check && npm run build --ignore-scripts && npm run test:firecracker && npm test && node dist/cli.js --help",
    "start": "node dist/cli.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-mcp": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "commander": "14.0.2",
    "diff": "8.0.4",
    "htmlparser2": "10.0.0",
    "proper-lockfile": "4.1.2",
    "saxes": "6.0.0",
    "sharp": "0.35.5",
    "typebox": "1.3.27",
    "typescript": "5.9.3",
    "undici": "8.10.2",
    "yaml": "2.9.0",
    "yauzl": "3.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "4.1.4",
    "@types/yauzl": "2.10.3",
    "prettier": "^3.6.2"
  }
}
