{
  "name": "@viasnake/agent",
  "version": "0.2.0",
  "private": true,
  "description": "A web-accessible Pi Durable agent for prepared Ubuntu systems",
  "type": "module",
  "engines": {
    "node": "26.13.x"
  },
  "scripts": {
    "build": "node scripts/build.mjs --clean && tsc -p tsconfig.build.json && node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node scripts/build.mjs --clean-tests && tsc -p tsconfig.test.json && node --test --test-concurrency=1 .test-dist/tests/*.test.js",
    "test:e2e": "node scripts/build.mjs --clean-tests && tsc -p tsconfig.test.json && node --test .test-dist/tests/e2e/*.test.js",
    "test:guest": "node scripts/guest-test.mjs",
    "test:live": "node scripts/live-test.mjs",
    "verify": "npm run format:check && npm run check && npm run build && npm run test:install && npm test && npm run test:e2e && node dist/src/main.js --help",
    "start": "node dist/src/main.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:install": "python3 -B -m unittest discover -s tests -p \"test_*.py\" && node --check scripts/guest-test.mjs && node --check scripts/live-test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1127.0",
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "11.2.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "fastify": "5.12.8",
    "sharp": "0.35.5",
    "yaml": "2.9.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@assistant-ui/react": "0.15.32",
    "@assistant-ui/store": "0.3.22",
    "@assistant-ui/tap": "0.9.24",
    "@earendil-works/pi-schema": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bootstrap": "6.0.0-alpha.1",
    "esbuild": "0.28.2",
    "google-auth-library": "10.9.1",
    "highlight.js": "11.12.0",
    "playwright": "1.65.0",
    "prettier": "3.6.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "typescript": "5.9.3"
  }
}
