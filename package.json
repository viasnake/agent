{
  "name": "@viasnake/agent",
  "version": "0.2.0",
  "private": true,
  "description": "A personal work agent inside a manually started Linux VM",
  "type": "module",
  "engines": {
    "node": "26.13.x"
  },
  "scripts": {
    "build": "node scripts/build.mjs --clean && tsc -p tsconfig.build.json && node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node scripts/build.mjs --clean-tests && tsc -p tsconfig.test.json && node --test --test-concurrency=1 .test-dist/tests/*.test.js",
    "test:e2e": "node scripts/build.mjs --clean-tests && tsc -p tsconfig.test.json && node --test .test-dist/tests/e2e/*.test.js",
    "test:guest": "node scripts/guest-test.mjs",
    "test:live": "node scripts/live-test.mjs",
    "verify": "npm run format:check && npm run check && npm run build && npm run test:vm && npm test && npm run test:e2e && node dist/src/main.js --help",
    "start": "node dist/src/main.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:vm": "python3 -B -m unittest discover -s tests -p \"test_*.py\" && node --check scripts/guest-test.mjs && node --check scripts/live-test.mjs"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "11.2.2",
    "fastify": "5.12.8",
    "playwright": "1.65.0",
    "yaml": "2.9.0",
    "zod": "4.6.5",
    "marked": "17.0.4",
    "sanitize-html": "2.17.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/sanitize-html": "2.16.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
